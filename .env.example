# Required: the host running Crab-hole, reached over SSH.
CRAB_HOLE_SSH_HOST=your-server-ip-or-hostname

# Optional overrides (defaults shown):
# CRAB_HOLE_SSH_USER=ubuntu
# CRAB_HOLE_SSH_CONFIG=/dev/null
# CRAB_HOLE_REMOTE_HELPER=/usr/local/sbin/crab-hole-admin
# CRAB_HOLE_TIMEOUT_MS=90000

# Mutating tools (replace_crab_hole_config, restore_crab_hole_config,
# control_crab_hole_service, add_custom_rule, remove_custom_rule) are
# disabled unless this is explicitly set to true.
# CRAB_HOLE_MUTATIONS_ENABLED=false
